generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  MECHANIC
  ADMIN
  SHOP_OWNER

}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  ONLINE
}

// Distinct from PaymentStatus (above, used by Invoice) — Invoice only ever
// needs UNPAID/PAID, but a Payment attempt itself can be PENDING (owner
// chose a method, hasn't completed it) or FAILED (online charge declined),
// states Invoice never needs to represent on its own.
enum PaymentTxnStatus {
  PENDING
  PAID
  FAILED
}


enum BookingStatus {
  PENDING             // owner submitted the booking request
  DECLINED            // mechanic declined — owner must choose another mechanic
  CONFIRMED           // mechanic accepted — must send a cost estimate next
  ESTIMATE_SENT       // mechanic sent an estimate — waiting on owner
  ESTIMATE_ACCEPTED   // owner accepted the estimate — mechanic may travel
  EN_ROUTE            // mechanic traveling to the owner
  IN_PROGRESS         // repair underway
  DONE                // repair completed — invoice generated
  CANCELLED
}

enum BookingType {
  SCHEDULED    // owner manually picks a mechanic (existing flow)
  EMERGENCY    // system auto-assigns from ranked candidates
}

enum DocumentStatus {
  PENDING     // photo captured, extraction in flight
  EXTRACTED   // model returned fields — waiting on owner to confirm/edit
  CONFIRMED   // owner confirmed — fields are now trusted, copied onto Vehicle
  FAILED      // extraction errored out (bad photo, model/API failure, etc.)
}

// ─────────────────────────────────────────────────────────────────────────────
// BETTER AUTH MODELS (unchanged)
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TwoFactor {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String
  backupCodes String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// APP MODELS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  phone            String?           @unique
  image            String?
  role             Role              @default(OWNER)
  emailVerified    Boolean           @default(false)
  twoFactorEnabled Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  homeAddress      String?
  homeLat          Float?
  homeLng          Float?

  // Relations
  accounts           Account[]
  sessions           Session[]
  twoFactor          TwoFactor?
  notifications      Notification[]
  mechanicProfile    MechanicProfile?
  messages           Message[]
  vehicles           Vehicle[]         @relation("UserVehicles")
  bookingsAsOwner    Booking[]         @relation("OwnerBookings")
  bookingsAsMechanic Booking[]         @relation("MechanicBookings")
  ratingsGiven       MechanicRating[]  @relation("GivenRatings")
  ratingsReceived    MechanicRating[]  @relation("ReceivedRatings")  // NEW
  shopOwned          RepairShop?       @relation("ShopOwner")
  shopRatingsGiven   ShopRating[]      @relation("ShopRatingsGiven")
  paymentsConfirmed  Payment[]         @relation("PaymentConfirmedBy")
  vehicleDocumentsUploaded  VehicleDocument[]  @relation("VehicleDocumentsUploaded")
  inspectionFlagsOwned      InspectionFlag[]   @relation("InspectionFlagsOwned")
  inspectionFlagsReviewed   InspectionFlag[]   @relation("InspectionFlagsReviewed")
}

model MechanicProfile {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  shopName           String?
  bio                String?
  specialization     String
  isAvailable        Boolean                  @default(true)
  certificationFile  String?
  yearsExperience    Int?
  verificationStatus VerificationStatus       @default(PENDING)
  isVerified         Boolean                  @default(false)
  latitude           Float?
  longitude          Float?
  locationUpdatedAt  DateTime?                                 // when location was last pushed
  createdAt          DateTime                 @default(now())
  shopId             String?                                   //   Note: shopId = NULL means an independent mechanic.
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations    MechanicSpecialization[]
  shop               RepairShop?              @relation(fields: [shopId], references: [id])

}

model Vehicle {
  id           String    @id @default(cuid())
  ownerId      String
  brand        String
  model        String
  yearModel    Int?
  plateNumber  String?

  // NEW fields ↓
  color        String?                          // e.g. "Silver", "Black"
  mileage      Int?                             // in kilometres
  fuelType     String?                          // Petrol | Diesel | Electric | Hybrid
  transmission String?                          // Manual | Automatic
  healthStatus String?   @default("GOOD")       // GOOD | FAIR | NEEDS_ATTENTION
  lastServiceAt DateTime?                       // date of last service
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  bookings     Booking[]
  owner        User      @relation("UserVehicles", fields: [ownerId], references: [id])
  documents    VehicleDocument[]
  inspectionFlags   InspectionFlag[]
}

model Booking {
  aiMatchScore       Float?
  bookingType        BookingType @default(SCHEDULED)
  declinedByIds      String[]    @default([])
  id                 String        @id @default(cuid())
  ownerId            String
  mechanicId         String?
  vehicleId          String
  problemDescription String
  isEmergency        Boolean @default(false)
  address            String?
  ownerLat           Float?                           // owner's pinned location
  ownerLng           Float?
  shopId             String?
  status             BookingStatus @default(PENDING)
  scheduledAt        DateTime?                        // when the job is scheduled
  price              Decimal?  @db.Decimal(10, 2)    // agreed/estimated price in ₱
  notes              String?                          // extra notes from owner/mechanic
  completedAt        DateTime?                        // set when status → DONE
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  // Relations
  mechanic           User?          @relation("MechanicBookings", fields: [mechanicId], references: [id])
  messages           Message[]
  owner              User           @relation("OwnerBookings",    fields: [ownerId],    references: [id])
  vehicle            Vehicle        @relation(fields: [vehicleId], references: [id])
  rating             MechanicRating?                  // NEW — one rating per booking
  shopRating         ShopRating?    @relation("ShopRatingBooking")
  shop               RepairShop?    @relation(fields: [shopId], references: [id])
  estimate           CostEstimate?
  invoice            Invoice?
  payment            Payment?
  inspectionFlags   InspectionFlag[]
}

// NEW — owner rates a mechanic after a booking is completed
model MechanicRating {
  id         String   @id @default(cuid())
  mechanicId String
  ownerId    String
  bookingId  String   @unique                  // one rating per booking
  rating     Int                               // 1–5 stars
  comment    String?
  sentiment  String?  @default("NEUTRAL")      // POSITIVE | NEUTRAL | NEGATIVE (AI-analyzed)
  createdAt  DateTime @default(now())

  mechanic   User     @relation("ReceivedRatings", fields: [mechanicId], references: [id])
  owner      User     @relation("GivenRatings",    fields: [ownerId],    references: [id])
  booking    Booking  @relation(fields: [bookingId], references: [id])
}

model Specialization {
  id        String                   @id @default(cuid())
  name      String                   @unique
  mechanics MechanicSpecialization[]
}

model MechanicSpecialization {
  mechanicId       String
  specializationId String
  mechanic         MechanicProfile @relation(fields: [mechanicId], references: [id])
  specialization   Specialization  @relation(fields: [specializationId], references: [id])

  @@id([mechanicId, specializationId])
}

model RepairShop {
  id                 String              @id @default(cuid())
  ownerId            String              @unique   // User with role SHOP_OWNER — business-only, does not repair
  name               String
  description        String?
  address            String
  latitude           Float?
  longitude          Float?
  phone              String?
  email              String?
  logoUrl            String?
  operatingHours     Json?               // { mon: "8:00-18:00", tue: "...", ... }
  services           String[]            @default([])   // e.g. ["Engine Repair", "Tire Service"]
  verificationStatus VerificationStatus  @default(PENDING)
  isVerified         Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  owner              User                @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  mechanics          MechanicProfile[]
  ratings            ShopRating[]
  bookings           Booking[]
}

model ShopRating {
  id         String   @id @default(cuid())
  shopId     String
  ownerId    String
  bookingId  String   @unique
  rating     Int                              // 1–5 stars
  comment    String?
  sentiment  String?  @default("NEUTRAL")
  createdAt  DateTime @default(now())

  shop       RepairShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  owner      User       @relation("ShopRatingsGiven", fields: [ownerId], references: [id])
  booking    Booking    @relation("ShopRatingBooking", fields: [bookingId], references: [id])
}

model CostEstimate {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  laborCost   Decimal   @db.Decimal(10, 2)
  partsCost   Decimal   @db.Decimal(10, 2) @default(0)
  totalCost   Decimal   @db.Decimal(10, 2)
  notes       String?
  isAccepted  Boolean   @default(false)
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  invoiceNumber String        @unique
  laborCost     Decimal       @db.Decimal(10, 2)
  partsCost     Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  notes         String?
  generatedAt   DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// Sits alongside Invoice rather than inside it — Invoice.paymentStatus stays
// the simple UNPAID/PAID flag the existing UI already reads; Payment tracks
// the actual attempt (method chosen, PayMongo source, cash confirmation).
// No direct FK to Invoice — bookingId already gives a 1:1 path to the
// invoice via Booking.invoice, so this just relates to Booking directly.
model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount Decimal           @db.Decimal(10, 2) // copied from Invoice.totalAmount when the method is chosen
  method PaymentMethod?                        // null until the owner picks one
  status PaymentTxnStatus  @default(PENDING)

  // --- ONLINE (PayMongo) fields — populated only when method = ONLINE ---
  providerSourceId String? @unique // PayMongo Source id, e.g. "src_xxx"
  checkoutUrl       String?
  paidVia           String?        // "gcash" | "maya"
  failureReason     String?

  // --- CASH fields — populated only when method = CASH ---
  confirmedById   String?
  confirmedBy     User?     @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  cashConfirmedAt DateTime?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}

model Message {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id])
  senderId  String
  sender    User      @relation(fields: [senderId], references: [id])
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([bookingId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String    // "BOOKING_ACCEPTED" | "ESTIMATE_SENT" | "ESTIMATE_ACCEPTED" | "ESTIMATE_DECLINED" | "EN_ROUTE" | "IN_PROGRESS" | "DONE" | "NEW_MESSAGE"
  title     String
  body      String?
  link      String?   // where tapping it navigates, e.g. "/dashboard/owner"
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model VehicleDocument {
  id           String   @id @default(cuid())
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  uploadedById String
  uploadedBy   User     @relation("VehicleDocumentsUploaded", fields: [uploadedById], references: [id])

  // Pragmatic MVP choice, flagged explicitly: the photo is stored as a
  // base64 data URI directly in this column, not in a separate object-storage
  // service. Zero setup, works today, fits the project's existing
  // "working code over architectural purity" preference. Swap for a real
  // storage service (Cloudinary/Supabase/Vercel Blob free tiers all exist)
  // before this sees real volume — data URIs bloat the DB and every
  // `select *` on this table gets expensive fast. The field is just named
  // `image` (not `imageDataUri`) so that swap doesn't need a schema change,
  // just a different string going into the same column.
  image        String   @db.Text

  // Extracted fields — every one nullable because the model is instructed
  // to return null rather than guess when it isn't confident (per spec).
  plateNumber   String?
  mvFileNumber  String?
  engineNumber  String?
  chassisNumber String?
  make          String?
  series        String?
  bodyType      String?
  color         String?
  yearModel     String?
  grossWeight   String?
  ownerName     String?

  confidence   Float?  // overall 0–1 confidence reported by the model
  rawResponse  Json?   // full model output kept for debugging/re-parsing

  status      DocumentStatus @default(PENDING)
  confirmedAt DateTime?
  failReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, createdAt])
}

model InspectionFlag {
  id        String   @id @default(cuid())
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  ownerId   String
  owner     User     @relation("InspectionFlagsOwned", fields: [ownerId], references: [id])

  // Optional — set when the scan happens from within an active booking's
  // context (narrows who's authorized to review, see inspection.ts). Null
  // for a freeform AI-chat scan not tied to any booking yet.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  image String @db.Text // same pragmatic base64-in-column choice as VehicleDocument.image

  issueType   String  // "dent" | "rust" | "cracked_part" | "tire_wear" | "fluid_leak" — free-text, not an enum, since the model may surface a category not yet anticipated
  description String
  confidence  Float
  severity    String? // "minor" | "moderate" | "needs_attention" — model may omit

  rawResponse Json?

  // Nothing becomes a "confirmed issue" until a human mechanic signs off —
  // per spec, this is a triage aid, never shown to the owner as a diagnosis.
  mechanicReviewed  Boolean   @default(false)
  mechanicConfirmed Boolean?  // null = not reviewed yet
  reviewedById      String?
  reviewedBy        User?     @relation("InspectionFlagsReviewed", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, createdAt])
  @@index([ownerId, createdAt])
  @@index([mechanicReviewed])
}